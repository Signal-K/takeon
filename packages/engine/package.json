{
  "name": "@takeon/engine",
  "version": "0.2.4",
  "description": "Framework-agnostic isometric voxel rover game engine. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./go": {
      "types": "./dist/go/index.d.ts",
      "import": "./dist/go/index.js"
    },
    "./go/takeon.wasm": "./dist/go/takeon.wasm",
    "./go/wasm_exec": "./dist/go/wasm_exec.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Signal-K/takeon.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/Signal-K/takeon#readme",
  "bugs": "https://github.com/Signal-K/takeon/issues",
  "keywords": [
    "game-engine",
    "isometric",
    "voxel",
    "rover",
    "space",
    "canvas",
    "simulation",
    "pixijs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/build-go-assets.mjs --clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "node scripts/build-go-assets.mjs && tsc -p tsconfig.json --noEmit",
    "build:go": "npm run build",
    "prepack": "npm run build:go",
    "pretest": "node scripts/build-go-assets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
