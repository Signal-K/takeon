{
  "name": "@takeon/pixi",
  "version": "0.2.2",
  "description": "Mount the TakeOn rover game inside a PixiJS application (e.g. Landnam).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Signal-K/takeon.git",
    "directory": "packages/pixi-adapter"
  },
  "homepage": "https://github.com/Signal-K/takeon#readme",
  "bugs": "https://github.com/Signal-K/takeon/issues",
  "keywords": [
    "pixijs",
    "pixi",
    "game",
    "isometric",
    "voxel",
    "rover",
    "embed"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@takeon/engine": "^0.2.0"
  },
  "peerDependencies": {
    "pixi.js": ">=7"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
