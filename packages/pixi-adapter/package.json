{
  "name": "@takeon/pixi",
  "version": "0.1.0",
  "description": "Mount the TakeOn rover game inside a PixiJS application (e.g. Landnam).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@takeon/engine": "*"
  },
  "peerDependencies": {
    "pixi.js": ">=7"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": false
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
